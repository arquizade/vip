# Obsidian local settings and cache
vault/main/.obsidian/workspace*.json
vault/main/.obsidian/cache

# Attachments can be large. Keep them out of git if you prefer.
vault/main/05-attachments/*
!vault/main/05-attachments/.gitkeep

# Generated graph files (rebuild with Graphify)
vault/graphify-out/*
!vault/graphify-out/README.md
!vault/graphify-out/.gitkeep

# Python and OS files
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Local secrets
.env
*.secret
